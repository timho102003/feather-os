# OpenAI (Responses API)
OPENAI_API_KEY=
# OpenRouter (Chat Completions, multi-model routing)
OPEN_ROUTER_API_KEY=
# Anthropic Claude (Messages API)
ANTHROPIC_API_KEY=

# PARALLEL Websearch
PARALLEL_API_KEY=
# GEMINI (memory embeddings) — GOOGLE_API_KEY or GEMINI_API_KEY both accepted
GOOGLE_API_KEY=

# Qdrant (long-term memory). URL also configurable in config/app.yaml.
# QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# Kill switch — set to 1 to force-disable memory regardless of YAML.
# FEATHER_MEMORY_DISABLED=1